{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_PACKAGE_MANAGER_AUTO_UPDATE": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)"
    ],
    "deny": [
      "Read(~/.config/secrets/*)",
      "Read(//**/.env)"
    ],
    "defaultMode": "auto"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.py",
    "padding": 0
  },
  "outputStyle": "sanity",
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-ansi",
  "editorMode": "vim",
  "vimInsertModeRemaps": {
    "jk": "<Esc>",
    "kj": "<Esc>"
  },
  "enabledPlugins": {
    "canonize@skill-ensemble": true,
    "inquisitry@skill-ensemble": true,
    "bibliomancy@skill-ensemble": true
  },
  "extraKnownMarketplaces": {
    "skill-ensemble": {
      "source": {
        "source": "directory",
        "path": "emiliasimmons/skills-ensemble"
      }
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/sync_settings.py"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/sync_settings.py"
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "matcher": "user_settings",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/sync_settings.py"
          }
        ]
      }
    ]
  }
}
