[user]
  name = Emilia Simmons
  email = emilia.milisims@gmail.com
[core]
  editor = vim
  whitespace = fix,-indent-with-non-tab,trailing-space,cr-at-eol
  pager = less -+$LESS -FRX
[credential]
  helper = cache --timeout=3600
[rerere]
  enabled = 1
  autoupdate = 1
[push]
  default = matching
[color]
  diff = auto
  status = auto
  branch = auto
[diff]
  tool = vimdiff
[difftool]
  prompt = false
[alias]
  st = status
  ci = commit -v
  co = checkout
  br = branch
  unstage = reset HEAD --
  last = log -1 HEAD
  cfg = !git -C $HOME --git-dir=$HOME/.cfg
[pull]
  ff = only
[init]
  defaultBranch = main
